# OneAPI Node server environment
# Runtime: Node.js 24.x (>=24.15.0, <25)
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# PUBLIC_ORIGIN=https://api.example.com
# Optional exact trusted LAN origins; use startup --lan to discover current private IPs.
# LAN_ORIGINS=http://192.168.1.10:8787,http://[fd00::10]:8787
# Startup flags override these network defaults without changing this file.

# Generate real values with: node setup.mjs --env-path /etc/oneapi/oneapi.env
ADMIN_API_KEY=replace-with-at-least-32-random-characters
GATEWAY_API_KEY=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-in-standard-base64
